{
  "$comment": "線上に出る名前と定数の唯一の定義場所。規則と対象の線引きは wire.md、決定の経緯は ADR-022。JSON にコメントは書けないので、説明はすべて wire.md に置く。",
  "protocol_version": 1,
  "namespace_by_role": {
    "shell": "os.",
    "stage": "stage."
  },
  "methods": {
    "stage": [
      "stage.setup.state",
      "stage.setup.prompt",
      "stage.speech.started",
      "stage.speech.ended",
      "stage.user.said",
      "stage.character.model",
      "stage.character.expression",
      "stage.inspector.state",
      "stage.settings.state"
    ],
    "os": [
      "os.window.get_position",
      "os.window.set_position"
    ]
  },
  "$comment_inbound": "Stage → Core の要求（ADR-028）。**ここに無い method は届かない**（WsServer.on_request の登録が allowlist そのもの）",
  "inbound_methods": [
    "stage.settings.update"
  ],
  "setup_components": [
    "tts",
    "stt"
  ],
  "$comment_reasons": "stage.character.model の reason（ADR-036）。**Core は表示文字列を送らない。** Stage が i18n の character.model.<reason> で訳す。知らないコードはそのまま表示する",
  "character_model_reasons": [
    "model_not_in_pack",
    "pack_unreadable"
  ],
  "setup_prompt_choices": {
    "install": "install",
    "skip": "skip"
  },
  "tauri_events": {
    "hover_state": "shell:hover:state",
    "core_endpoint": "shell:core:endpoint"
  },
  "tauri_commands": [
    "shell_hit_region_set",
    "shell_core_endpoint",
    "shell_window_drag_start",
    "shell_window_scale",
    "shell_locale_set",
    "shell_credits_open",
    "shell_app_quit"
  ],
  "window_labels": [
    "stage",
    "credits",
    "permission",
    "settings"
  ],
  "enums": {
    "tts_setup_state": [
      "unknown",
      "not_configured",
      "detected",
      "installing",
      "installed",
      "failed"
    ],
    "engine_runtime": [
      "stopped",
      "starting",
      "ready",
      "failed"
    ],
    "boot_phase": [
      "setup",
      "installing",
      "starting",
      "blocked",
      "ready"
    ],
    "llm_setup_state": [
      "unknown",
      "not_configured",
      "detected",
      "model_missing"
    ],
    "stt_setup_state": [
      "unknown",
      "not_configured",
      "installing",
      "installed",
      "failed"
    ],
    "settings_source": [
      "default",
      "file",
      "env"
    ],
    "emotion": [
      "neutral",
      "happy",
      "sad",
      "angry",
      "surprised",
      "think",
      "curious",
      "awkward",
      "sleepy"
    ],
    "viseme": [
      "A",
      "I",
      "U",
      "E",
      "O"
    ],
    "model_format": [
      "vrm0",
      "vrm1"
    ]
  }
}
