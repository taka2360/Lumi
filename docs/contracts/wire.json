{
  "$comment": "The single source of truth for on-the-wire names and constants. See wire.md for rules and boundaries, and ADR-022 for decision history. Since JSON does not support comments, all explanations live in wire.md",
  "protocol_version": 1,
  "namespace_by_role": {
    "shell": "os.",
    "stage": "stage.",
    "panel": "panel."
  },
  "methods": {
    "stage": [
      "stage.setup.state",
      "stage.setup.prompt",
      "stage.speech.started",
      "stage.speech.ended",
      "stage.user.said",
      "stage.character.model",
      "stage.character.expression",
      "stage.settings.state",
      "stage.audio.mic"
    ],
    "os": [
      "os.window.get_position",
      "os.window.set_position"
    ],
    "panel": [
      "panel.settings.state",
      "panel.inspector.state",
      "panel.memory.state"
    ]
  },
  "$comment_inbound": "Stage -> Core requests (ADR-028). Methods not listed here will not be delivered (WsServer.on_request registration serves as the allowlist itself)",
  "inbound_methods": [
    "stage.settings.update",
    "stage.setup.recheck_ollama",
    "stage.audio.mute",
    "panel.settings.update",
    "panel.memory.search",
    "panel.memory.edit",
    "panel.memory.forget",
    "panel.memory.confirm",
    "panel.memory.export",
    "panel.memory.erase_preview",
    "panel.memory.erase"
  ],
  "setup_components": [
    "tts",
    "stt",
    "llm_model"
  ],
  "$comment_reasons": "Reasons for stage.character.model (ADR-036). **Core never sends display strings.** Stage translates via i18n character.model.<reason>. Unknown codes are displayed as-is",
  "character_model_reasons": [
    "model_not_in_pack",
    "pack_unreadable"
  ],
  "setup_prompt_choices": {
    "install": "install",
    "skip": "skip",
    "select": "select"
  },
  "tauri_events": {
    "hover_state": "shell:hover:state",
    "core_endpoint": "shell:core:endpoint"
  },
  "tauri_commands": [
    "shell_hit_region_set",
    "shell_core_endpoint",
    "shell_window_drag_start",
    "shell_window_scale",
    "shell_locale_set",
    "shell_credits_open",
    "shell_panel_open",
    "shell_ollama_site_open",
    "shell_app_quit"
  ],
  "window_labels": [
    "stage",
    "credits",
    "permission",
    "settings",
    "inspector",
    "memory"
  ],
  "enums": {
    "tts_setup_state": [
      "unknown",
      "not_configured",
      "detected",
      "installing",
      "installed",
      "failed"
    ],
    "engine_runtime": [
      "stopped",
      "starting",
      "ready",
      "failed"
    ],
    "boot_phase": [
      "setup",
      "installing",
      "starting",
      "blocked",
      "ready"
    ],
    "llm_setup_state": [
      "unknown",
      "not_configured",
      "detected",
      "model_missing",
      "model_installing",
      "model_failed"
    ],
    "stt_setup_state": [
      "unknown",
      "not_configured",
      "installing",
      "installed",
      "failed"
    ],
    "settings_source": [
      "default",
      "file",
      "env"
    ],
    "emotion": [
      "neutral",
      "happy",
      "sad",
      "angry",
      "surprised",
      "think",
      "curious",
      "awkward",
      "sleepy"
    ],
    "viseme": [
      "A",
      "I",
      "U",
      "E",
      "O"
    ],
    "model_format": [
      "vrm0",
      "vrm1"
    ],
    "panel_kind": [
      "settings",
      "inspector",
      "memory"
    ],
    "memory_type": [
      "episodic",
      "semantic",
      "procedural"
    ],
    "assertion_mode": [
      "user_confirmed",
      "user_stated",
      "inferred",
      "self_generated",
      "external"
    ],
    "erase_target": [
      "episodes",
      "domain_events",
      "audit_log",
      "memory_records"
    ]
  }
}
